# Auto-generated by ~/.claude/skills/setup-coolify/scripts/generate-workflow.sh
# Source: @@SOURCE@@
# Pattern: GHCR same-image promotion, manual production release (promotion: manual).
#   deploy.yml   — after CI passes on a merge to main: gate, build, deploy STAGING only.
#   promote.yml  — started by a release owner: the image staging runs goes to production.
#   rollback.yml — started by a release owner: put back an image the environment ran before.
# Do not hand-edit — regenerate via /setup-coolify (rerun) instead.
#
# NOTE: NEXT_PUBLIC_BASE_URL (and any other env-specific value) is intentionally
# NOT passed as a --build-arg. Same-image promotion requires identical image bytes
# across staging and production; env-specific values flow through DOPPLER_TOKEN at
# container startup.
# Exception: GIT_SHA and BUILD_TIMESTAMP are identity-only build-args (same commit
# hash and timestamp for staging and production) — they do not break same-image promotion.
name: Deploy

on:
  workflow_run:
    workflows: [@@CI_WORKFLOW_JSON@@]
    types: [completed]
    branches: [main]
  schedule:
    - cron: '0 8 * * 1'   # Monday 8am UTC — weekly drift check

permissions:
  contents: read

# One staging deploy at a time, never cancelled part-way. GitHub replaces an older run
# that is still pending with the newer one, so an older commit never deploys after a newer one.
concurrency:
  group: staging
  cancel-in-progress: false

jobs:
  gate:
    # Every other job needs this one. On the schedule it only says so (drift check only).
    # After CI: the commit must still be the tip of main (else: superseded, success, nothing
    # deployed), CI must have succeeded on that push, and a merged pull request must have
    # made the commit. Later jobs check out and build workflow_run.head_sha (the commit CI
    # tested), never the run's own commit, which is whatever main points at now.
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    outputs:
      proceed: ${{ steps.gate.outputs.proceed }}
      sha: ${{ steps.gate.outputs.sha }}
      tag: ${{ steps.gate.outputs.tag }}
    steps:
      - name: Release gate (tip of main, CI result, merged pull request)
        id: gate
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          EVENT_NAME: ${{ github.event_name }}
          HEAD_SHA: ${{ github.event.workflow_run.head_sha }}
          CI_EVENT: ${{ github.event.workflow_run.event }}
          CI_HEAD_BRANCH: ${{ github.event.workflow_run.head_branch }}
          CI_CONCLUSION: ${{ github.event.workflow_run.conclusion }}
          CI_URL: ${{ github.event.workflow_run.html_url }}
        run: |
          @@LOAD_GATE@@
          gate_merge main

  build:
    needs: gate
    if: needs.gate.outputs.proceed == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      tag: ${{ needs.gate.outputs.tag }}
      digest: ${{ steps.build.outputs.digest }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.workflow_run.head_sha }}
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - id: build
        uses: docker/build-push-action@v6
        with:
          context: @@BUILD_CONTEXT@@
          file: @@BUILD_DOCKERFILE@@
          push: true
          tags: @@REGISTRY_IMAGE_NAME@@:${{ needs.gate.outputs.tag }}
          # GIT_SHA and BUILD_TIMESTAMP are identity-only build-args (not env-specific).
          build-args: |
            GIT_SHA=${{ needs.gate.outputs.tag }}
            BUILD_TIMESTAMP=${{ github.event.workflow_run.head_commit.timestamp }}

  deploy-staging:
    needs: [gate, build]
    if: needs.gate.outputs.proceed == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      deployments: write
    env:
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
      RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
      COOLIFY_API_KEY: ${{ secrets.COOLIFY_API_KEY }}
      COOLIFY_URL: @@COOLIFY_URL@@
      STAGING_APP_UUID: @@STAGING_APP_UUID@@
      STAGING_DOMAIN: @@STAGING_DOMAIN@@
      HEAD_SHA: ${{ github.event.workflow_run.head_sha }}
      TAG: ${{ needs.build.outputs.tag }}
      DIGEST: ${{ needs.build.outputs.digest }}
      STARTED_BY: ${{ github.triggering_actor }}
      SMOKE_COMMAND: @@SMOKE_COMMAND_JSON@@
    steps:
      - name: Re-check the tip of main, then record the staging deploy
        # A newer merge may have landed while this run built. If so, stop here: success,
        # no staging record, nothing deployed. The record is created only after this check.
        id: begin
        run: |
          @@LOAD_GATE@@
          REPLACED=$(coolify_app_tag "$STAGING_APP_UUID")
          stage_begin "$HEAD_SHA" main "$TAG" "$DIGEST" "$REPLACED" "$STARTED_BY"
      - name: Set image tag on staging app
        if: steps.begin.outputs.proceed == 'true'
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          coolify_set_tag "$STAGING_APP_UUID" "$TAG"
      - name: Deploy staging + wait for Coolify
        if: steps.begin.outputs.proceed == 'true'
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          coolify_deploy_wait "$STAGING_APP_UUID" staging
      - name: Smoke test staging
        if: steps.begin.outputs.proceed == 'true'
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          wait_healthy "https://$STAGING_DOMAIN@@HEALTH_CHECK_PATH@@" Staging
      - name: Assert staging version
        if: steps.begin.outputs.proceed == 'true'
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          assert_version "https://$STAGING_DOMAIN@@HEALTH_CHECK_PATH@@" "$TAG"
#@if smoke
      - name: Check out the image's commit for smoke_command
        if: steps.begin.outputs.proceed == 'true'
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.workflow_run.head_sha }}
      - name: Set up uv for smoke_command
        if: steps.begin.outputs.proceed == 'true'
        uses: astral-sh/setup-uv@v6
      - name: Run smoke_command against staging
        if: steps.begin.outputs.proceed == 'true'
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          run_smoke "https://$STAGING_DOMAIN"
#@endif
      - name: Record staging success
        if: steps.begin.outputs.proceed == 'true'
        env:
          RECORD_ID: ${{ steps.begin.outputs.record_id }}
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          record_status "$RECORD_ID" success "Staging runs $TAG; health, version and smoke passed"
      - name: Record staging failure
        if: failure() && steps.begin.outputs.record_id != ''
        env:
          RECORD_ID: ${{ steps.begin.outputs.record_id }}
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          record_status "$RECORD_ID" failure "Staging deploy of $TAG failed; see the run"

  drift-check:
    # Runs on the weekly schedule only.
    # INV-01: each Coolify app must hold exactly one env var (DOPPLER_TOKEN).
    # INV-04 (manual promotion): production runs its newest successful production release.
    # If INV-01 fails, run /setup-coolify (provision). If the release check fails, someone
    # changed production by hand: promote or roll back to put it right.
    needs: gate
    if: github.event_name == 'schedule'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      deployments: read
    env:
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
      COOLIFY_API_KEY: ${{ secrets.COOLIFY_API_KEY }}
      COOLIFY_URL: @@COOLIFY_URL@@
      STAGING_APP_UUID: @@STAGING_APP_UUID@@
      PROD_APP_UUID: @@PROD_APP_UUID@@
    steps:
      - name: INV-01 — verify only DOPPLER_TOKEN is set in each Coolify app
        run: |
          set -e
          failed=0
          for uuid in "$STAGING_APP_UUID" "$PROD_APP_UUID"; do
            stale=$(curl -sfS "$COOLIFY_URL/api/v1/applications/$uuid/envs" \
              -H "Authorization: Bearer $COOLIFY_API_KEY" \
              | jq -r '(if type == "array" then . else (.data // []) end) | [.[] | select(.key != "DOPPLER_TOKEN") | .key] | unique | join(" ")' \
              2>/dev/null || echo "")
            if [ -n "$stale" ]; then
              echo "FAIL INV-01 uuid=$uuid: stale vars found: $stale"
              echo "     Fix: run /setup-coolify (provision) in the target repo to remove them."
              failed=1
            else
              echo "OK   INV-01 uuid=$uuid (DOPPLER_TOKEN only)"
            fi
          done
          exit $failed
      - name: INV-04 — production runs its newest successful production release
        if: success() || failure()
        run: |
          @@LOAD_GATE@@
          PROD_TAG=$(coolify_app_tag "$PROD_APP_UUID")
          drift_production "$PROD_TAG"
