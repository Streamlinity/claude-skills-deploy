# Auto-generated by ~/.claude/skills/setup-coolify/scripts/generate-workflow.sh
# Source: @@SOURCE@@
# Roll back (promotion: manual). Started by hand by a release owner: GitHub Mobile
# (Actions → Roll back → Run workflow) or `gh workflow run rollback.yml`.
# With no tag it puts back the image the environment ran before its current release.
# A chosen tag must be an image that environment ran: it has a successful deployment
# record there, or one of those records replaced it. No build, no CI wait.
# Do not hand-edit — regenerate via /setup-coolify (rerun) instead.
name: Roll back

on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Environment to roll back"
        required: true
        default: production
        type: choice
        options:
          - production
          - staging
      tag:
        description: "Image tag (7-character commit). Leave empty for the image this environment ran before."
        required: false
        default: ""
        type: string

permissions:
  contents: read

# Promotions and rollbacks never overlap, and a running one is never cancelled.
concurrency:
  group: production
  cancel-in-progress: false

jobs:
  gate:
    # Refuses, deploying nothing, unless the person who started the run is a release owner
    # and the target image ran in that environment before and is still in the registry.
    runs-on: ubuntu-latest
    permissions:
      contents: read
      deployments: read
      packages: read
    outputs:
      tag: ${{ steps.gate.outputs.tag }}
      sha: ${{ steps.gate.outputs.sha }}
      digest: ${{ steps.gate.outputs.digest }}
      replaced_tag: ${{ steps.gate.outputs.replaced_tag }}
    env:
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
      COOLIFY_API_KEY: ${{ secrets.COOLIFY_API_KEY }}
      COOLIFY_URL: @@COOLIFY_URL@@
      STAGING_APP_UUID: @@STAGING_APP_UUID@@
      PROD_APP_UUID: @@PROD_APP_UUID@@
      IMAGE: @@REGISTRY_IMAGE_NAME@@
      ACTOR: ${{ github.triggering_actor }}
      RELEASE_OWNERS: @@RELEASE_OWNERS_JSON@@
      TARGET_ENV: ${{ inputs.environment }}
      INPUT_TAG: ${{ inputs.tag }}
    steps:
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Release gate (release owner, an image this environment ran before)
        id: gate
        run: |
          @@LOAD_GATE@@
          gate_actor "$ACTOR" "$RELEASE_OWNERS"
          if [ "$TARGET_ENV" = "production" ]; then APP_UUID="$PROD_APP_UUID"; else APP_UUID="$STAGING_APP_UUID"; fi
          CURRENT=$(coolify_app_tag "$APP_UUID")
          gate_rollback "$TARGET_ENV" "$CURRENT" "$INPUT_TAG"
          DIGEST=$(image_digest "$IMAGE" "$RG_TAG")
          rg_out digest "$DIGEST"

  deploy:
    needs: gate
    runs-on: ubuntu-latest
    permissions:
      contents: read
      deployments: write
    env:
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
      RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
      COOLIFY_API_KEY: ${{ secrets.COOLIFY_API_KEY }}
      COOLIFY_URL: @@COOLIFY_URL@@
      STAGING_APP_UUID: @@STAGING_APP_UUID@@
      PROD_APP_UUID: @@PROD_APP_UUID@@
      STAGING_DOMAIN: @@STAGING_DOMAIN@@
      PROD_DOMAIN: @@PROD_DOMAIN@@
      TARGET_ENV: ${{ inputs.environment }}
      TAG: ${{ needs.gate.outputs.tag }}
      SHA: ${{ needs.gate.outputs.sha }}
      DIGEST: ${{ needs.gate.outputs.digest }}
      REPLACED: ${{ needs.gate.outputs.replaced_tag }}
      STARTED_BY: ${{ github.triggering_actor }}
      SMOKE_COMMAND: @@SMOKE_COMMAND_JSON@@
    steps:
      - name: Record the rollback
        id: begin
        run: |
          @@LOAD_GATE@@
          if [ "$TARGET_ENV" = "production" ]; then
            echo "APP_UUID=$PROD_APP_UUID" >> "$GITHUB_ENV"
            echo "APP_DOMAIN=$PROD_DOMAIN" >> "$GITHUB_ENV"
          else
            echo "APP_UUID=$STAGING_APP_UUID" >> "$GITHUB_ENV"
            echo "APP_DOMAIN=$STAGING_DOMAIN" >> "$GITHUB_ENV"
          fi
          release_begin "$TARGET_ENV" "$SHA" rollback "$TAG" "$DIGEST" "$REPLACED" "$STARTED_BY"
      - name: Set the earlier image tag on the app
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          coolify_set_tag "$APP_UUID" "$TAG"
      - name: Deploy + wait for Coolify
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          coolify_deploy_wait "$APP_UUID" "$TARGET_ENV"
      - name: Smoke test
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          wait_healthy "https://$APP_DOMAIN@@HEALTH_CHECK_PATH@@" "$TARGET_ENV"
      - name: Assert version
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          assert_version "https://$APP_DOMAIN@@HEALTH_CHECK_PATH@@" "$TAG"
#@if smoke
      - name: Check out the image's commit for smoke_command
        uses: actions/checkout@v4
        with:
          ref: ${{ needs.gate.outputs.sha }}
      - name: Set up uv for smoke_command
        uses: astral-sh/setup-uv@v6
      - name: Run smoke_command
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          run_smoke "https://$APP_DOMAIN"
#@endif
      - name: Record rollback success
        env:
          RECORD_ID: ${{ steps.begin.outputs.record_id }}
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          record_status "$RECORD_ID" success "$TARGET_ENV runs $TAG again (replaced $REPLACED); health, version and smoke passed"
      - name: Record rollback failure
        if: failure() && steps.begin.outputs.record_id != ''
        env:
          RECORD_ID: ${{ steps.begin.outputs.record_id }}
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          record_status "$RECORD_ID" failure "Rollback of $TARGET_ENV to $TAG failed; see the run"
