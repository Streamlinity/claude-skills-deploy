# Auto-generated by ~/.claude/skills/setup-coolify/scripts/generate-workflow.sh
# Source: @@SOURCE@@
# Promote to production (promotion: manual). Started by hand by a release owner:
# GitHub Mobile (Actions → Promote to production → Run workflow) or
# `gh workflow run promote.yml`. Leave `tag` empty for the image staging runs now.
# Do not hand-edit — regenerate via /setup-coolify (rerun) instead.
name: Promote to production

on:
  workflow_dispatch:
    inputs:
      tag:
        description: "Image tag (7-character commit). Leave empty for the image staging runs now."
        required: false
        default: ""
        type: string

permissions:
  contents: read

# Promotions and rollbacks never overlap, and a running one is never cancelled.
concurrency:
  group: production
  cancel-in-progress: false

jobs:
  gate:
    # Refuses, deploying nothing, unless: the person who started the run is a release
    # owner, the tag is the image staging runs now, and it has a successful staging record.
    runs-on: ubuntu-latest
    permissions:
      contents: read
      deployments: read
    outputs:
      tag: ${{ steps.gate.outputs.tag }}
      sha: ${{ steps.gate.outputs.sha }}
      digest: ${{ steps.gate.outputs.digest }}
      replaced_tag: ${{ steps.gate.outputs.replaced_tag }}
      smoke_staging: ${{ steps.gate.outputs.smoke_staging }}
    env:
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
      COOLIFY_API_KEY: ${{ secrets.COOLIFY_API_KEY }}
      COOLIFY_URL: @@COOLIFY_URL@@
      STAGING_APP_UUID: @@STAGING_APP_UUID@@
      PROD_APP_UUID: @@PROD_APP_UUID@@
      ACTOR: ${{ github.triggering_actor }}
      RELEASE_OWNERS: @@RELEASE_OWNERS_JSON@@
      INPUT_TAG: ${{ inputs.tag }}
    steps:
      - name: Release gate (release owner, image staging runs, staging record)
        id: gate
        run: |
          @@LOAD_GATE@@
          gate_actor "$ACTOR" "$RELEASE_OWNERS"
          STAGING_TAG=$(coolify_app_tag "$STAGING_APP_UUID")
          PROD_TAG=$(coolify_app_tag "$PROD_APP_UUID")
          gate_promote "$STAGING_TAG" "$INPUT_TAG" "$PROD_TAG"

  smoke-staging:
    # Re-checks staging for this image unless its staging deploy passed within 24 hours.
    needs: gate
    if: needs.gate.outputs.smoke_staging == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: read
    env:
      STAGING_DOMAIN: @@STAGING_DOMAIN@@
      TAG: ${{ needs.gate.outputs.tag }}
      SMOKE_COMMAND: @@SMOKE_COMMAND_JSON@@
    steps:
      - name: Staging health and version
        run: |
          @@LOAD_GATE@@
          wait_healthy "https://$STAGING_DOMAIN@@HEALTH_CHECK_PATH@@" Staging
          assert_version "https://$STAGING_DOMAIN@@HEALTH_CHECK_PATH@@" "$TAG"
#@if smoke
      - name: Check out the image's commit for smoke_command
        uses: actions/checkout@v4
        with:
          ref: ${{ needs.gate.outputs.sha }}
      - name: Set up uv for smoke_command
        uses: astral-sh/setup-uv@v6
      - name: Run smoke_command against staging
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          run_smoke "https://$STAGING_DOMAIN"
#@endif

  deploy-production:
    needs: [gate, smoke-staging]
    if: ${{ !cancelled() && needs.gate.result == 'success' && (needs.smoke-staging.result == 'success' || needs.smoke-staging.result == 'skipped') }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      deployments: write
    env:
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
      RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
      COOLIFY_API_KEY: ${{ secrets.COOLIFY_API_KEY }}
      COOLIFY_URL: @@COOLIFY_URL@@
      PROD_APP_UUID: @@PROD_APP_UUID@@
      PROD_DOMAIN: @@PROD_DOMAIN@@
      TAG: ${{ needs.gate.outputs.tag }}
      SHA: ${{ needs.gate.outputs.sha }}
      DIGEST: ${{ needs.gate.outputs.digest }}
      REPLACED: ${{ needs.gate.outputs.replaced_tag }}
      STARTED_BY: ${{ github.triggering_actor }}
      SMOKE_COMMAND: @@SMOKE_COMMAND_JSON@@
    steps:
      - name: Record the production release
        id: begin
        run: |
          @@LOAD_GATE@@
          release_begin production "$SHA" promote "$TAG" "$DIGEST" "$REPLACED" "$STARTED_BY"
      - name: Set same image tag on production app (no rebuild)
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          coolify_set_tag "$PROD_APP_UUID" "$TAG"
      - name: Deploy production + wait for Coolify
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          coolify_deploy_wait "$PROD_APP_UUID" production
      - name: Smoke test production
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          wait_healthy "https://$PROD_DOMAIN@@HEALTH_CHECK_PATH@@" Production
      - name: Assert production version
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          assert_version "https://$PROD_DOMAIN@@HEALTH_CHECK_PATH@@" "$TAG"
#@if smoke
      - name: Check out the image's commit for smoke_command
        uses: actions/checkout@v4
        with:
          ref: ${{ needs.gate.outputs.sha }}
      - name: Set up uv for smoke_command
        uses: astral-sh/setup-uv@v6
      - name: Run smoke_command against production
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          run_smoke "https://$PROD_DOMAIN"
#@endif
      - name: Record production success
        env:
          RECORD_ID: ${{ steps.begin.outputs.record_id }}
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          record_status "$RECORD_ID" success "Production runs $TAG (replaced $REPLACED); health, version and smoke passed"
      - name: Record production failure
        if: failure() && steps.begin.outputs.record_id != ''
        env:
          RECORD_ID: ${{ steps.begin.outputs.record_id }}
        run: |
          source "$RUNNER_TEMP/release-gate.sh"
          record_status "$RECORD_ID" failure "Production deploy of $TAG failed; see the run"
          rg_note "Production release of $TAG failed. To put back $REPLACED, run the Roll back workflow (environment: production) and follow the release runbook."

  cleanup:
    # After a successful promotion only. Tags the deployed image `production` and the one it
    # replaced `production-previous`, then deletes old image versions, never the digests
    # (and child manifests) of production, production-previous or the image staging runs.
    needs: [gate, deploy-production]
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    env:
      COOLIFY_API_KEY: ${{ secrets.COOLIFY_API_KEY }}
      COOLIFY_URL: @@COOLIFY_URL@@
      STAGING_APP_UUID: @@STAGING_APP_UUID@@
      IMAGE: @@REGISTRY_IMAGE_NAME@@
      TAG: ${{ needs.gate.outputs.tag }}
      REPLACED: ${{ needs.gate.outputs.replaced_tag }}
    steps:
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Tag production and production-previous; list the digests to keep
        id: keep
        run: |
          @@LOAD_GATE@@
          if [ -n "$REPLACED" ] && [ "$REPLACED" != "$TAG" ]; then
            if image_digest "$IMAGE" "$REPLACED" >/dev/null 2>&1; then
              retag "$IMAGE" "$REPLACED" production-previous
            else
              echo "WARN: $IMAGE:$REPLACED is gone; production-previous is not moved"
            fi
          fi
          retag "$IMAGE" "$TAG" production
          STAGING_TAG=$(coolify_app_tag "$STAGING_APP_UUID")
          KEEP="production $STAGING_TAG"
          if image_digest "$IMAGE" production-previous >/dev/null 2>&1; then
            KEEP="$KEEP production-previous"
          fi
          IGNORE=$(keep_regex "$IMAGE" $KEEP)
          rg_out ignore "$IGNORE"
      - name: Delete old image versions (keep @@RETENTION@@ others)
        uses: actions/delete-package-versions@v5
        with:
          package-name: @@PACKAGE@@
          package-type: container
          min-versions-to-keep: @@RETENTION@@
          ignore-versions: ${{ steps.keep.outputs.ignore }}
